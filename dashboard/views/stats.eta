<%~ includeFile("partials/header", {
        user: user
}); %>
<%~ includeFile("partials/message.eta"); %>
<%~ includeFile("partials/title.eta", {
        icon: "fas fa-robot",
        title: "Bot stats"
}); %>

<section class="container my-4">
        <div class="row g-4">
                <div class="col-sm-6 col-lg-3">
                        <div class="ig-stat">
                                <div class="ig-stat-icon"><i class="fas fa-users"></i></div>
                                <div>
                                        <div class="ig-stat-value"><%= totalUser %></div>
                                        <div class="ig-stat-label">Users</div>
                                </div>
                        </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                        <div class="ig-stat">
                                <div class="ig-stat-icon"><i class="fas fa-comments"></i></div>
                                <div>
                                        <div class="ig-stat-value"><%= totalThread %></div>
                                        <div class="ig-stat-label">Threads</div>
                                </div>
                        </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                        <div class="ig-stat">
                                <div class="ig-stat-icon"><i class="fas fa-hashtag"></i></div>
                                <div>
                                        <div class="ig-stat-value"><%= prefix %></div>
                                        <div class="ig-stat-label">Prefix</div>
                                </div>
                        </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                        <div class="ig-stat">
                                <div class="ig-stat-icon"><i class="fa fa-clock"></i></div>
                                <div>
                                        <div class="ig-stat-value" id="uptime"><%= uptime %></div>
                                        <div class="ig-stat-label">Uptime</div>
                                </div>
                        </div>
                </div>
        </div>

        <div class="ig-card mt-4 p-4">
                <h5 class="mb-3"><i class="fas fa-microchip me-2"></i>Runtime</h5>
                <div class="row g-3">
                        <div class="col-sm-6">
                                <div class="ig-stat">
                                        <div class="ig-stat-icon"><i class="fab fa-node-js"></i></div>
                                        <div>
                                                <div class="ig-stat-value"><%= process.version %></div>
                                                <div class="ig-stat-label">Node.js</div>
                                        </div>
                                </div>
                        </div>
                        <div class="col-sm-6">
                                <div class="ig-stat">
                                        <div class="ig-stat-icon"><i class="fas fa-memory"></i></div>
                                        <div>
                                                <div class="ig-stat-value"><%= (process.memoryUsage().rss / 1024 / 1024).toFixed(2) %> MB</div>
                                                <div class="ig-stat-label">Memory (RSS)</div>
                                        </div>
                                </div>
                        </div>
                        <div class="col-sm-6">
                                <div class="ig-stat">
                                        <div class="ig-stat-icon"><i class="fas fa-plug"></i></div>
                                        <div>
                                                <div class="ig-stat-value"><%= fcaVersion %></div>
                                                <div class="ig-stat-label">@lazyneoaz/ig-chat-api</div>
                                        </div>
                                </div>
                        </div>
                        <div class="col-sm-6">
                                <div class="ig-stat">
                                        <div class="ig-stat-icon"><i class="fa-brands fa-instagram"></i></div>
                                        <div>
                                                <div class="ig-stat-value">Instagram</div>
                                                <div class="ig-stat-label">Engine platform</div>
                                        </div>
                                </div>
                        </div>
                </div>
        </div>

        <div class="ig-card mt-4 p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h5 class="mb-0"><i class="fas fa-heart-pulse me-2"></i>Keep-alive</h5>
                        <span class="ig-badge" id="uptime-health"><i class="fas fa-circle-notch fa-spin"></i> checking…</span>
                </div>
                <p class="text-muted mb-0 mt-2 small">
                        The bot pings its own <code>/uptime</code> endpoint on an interval so the host
                        does not sleep idle. Configure under <code>autoUptime</code> in <code>config.json</code>.
                </p>
        </div>

        <div class="text-center text-muted mt-4 small">
                Goat Bot IG by <a href="https://github.com/lazyneoaz" target="_blank" rel="noopener" class="ig-gradient-text fw-semibold">lazyneoaz (Saifullah Al Neoaz)</a>
                &middot; forked from NTKhang's GoatBot V2
        </div>
</section>

<script type="text/javascript">
  function cvt(e,t="second",o="minute ",n="hour ",r="day ",a="month ",c="year "){const u=Math.floor(e/1e3%60),i=Math.floor(e/1e3/60%60),l=Math.floor(e/1e3/60/60%24),f=Math.floor(e/1e3/60/60/24%30),h=Math.floor(e/1e3/60/60/24/30%12),m=Math.floor(e/1e3/60/60/24/30/12);return`${m?m+c:""}${h?h+a:m?"00"+a:""}${f?f+r:h||m?"00"+r:""}${l?l+n:f||h||m?"00"+n:""}${i?i+o:l||f||h||m?"00"+o:""}${u}${t}`}let countDownDate=Number("<%=uptimeSecond%>");setInterval((function(){countDownDate+=1,document.getElementById("uptime").innerHTML=cvt(1e3*countDownDate)}),1e3);

  (function() {
    const badge = document.getElementById("uptime-health");
    if (!badge) return;
    const setBadge = (cls, bg, html) => {
      badge.className = "ig-badge " + cls;
      badge.style.background = bg;
      badge.innerHTML = html;
    };
    const check = () => fetch("/uptime", { cache: "no-store" })
      .then(r => r.json())
      .then(d => {
        if (d.status === "success")
          setBadge("", "linear-gradient(45deg,#25b003,#0f8a02)", '<i class="fas fa-circle"></i> pinging &middot; online');
        else
          setBadge("", "linear-gradient(45deg,#e5780b,#bc3803)", '<i class="fas fa-triangle-exclamation"></i> account: ' + (d.statusAccountBot || "unknown"));
      })
      .catch(() => setBadge("", "linear-gradient(45deg,#ed2000,#b81800)", '<i class="fas fa-circle-xmark"></i> unreachable'));
    check();
    setInterval(check, 30000);
  })();
</script>

<%~ includeFile("partials/footer") %>
